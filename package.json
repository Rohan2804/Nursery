{
  "name": "vanam",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vanam/storefront & npm run dev --workspace @vanam/admin",
    "dev:storefront": "npm run dev --workspace @vanam/storefront",
    "dev:admin": "npm run dev --workspace @vanam/admin",
    "build": "npm run build --workspace @vanam/storefront && npm run build --workspace @vanam/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:seed-sql": "node packages/catalog/scripts/generate-seed.ts",
    "db:setup": "node scripts/db-setup.mjs",
    "admin:create-owner": "node scripts/create-owner.mjs"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "@supabase/supabase-js": "^2.49.0"
  }
}
