# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" (or legacy "anon") key — safe for browsers; row-level security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" (or legacy "service_role") key — server only. Used to invite team members.
SUPABASE_SECRET_KEY=

# Supabase → Project Settings → Database → Connection string (URI). Only used by `npm run db:setup`.
DATABASE_URL=

# Where this admin app is served (used in invite / password-reset emails)
ADMIN_URL=http://localhost:3001

# Storefront, so saves refresh the live site instantly. Use the same secret in the storefront's .env.local.
STOREFRONT_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-to-a-long-random-string
