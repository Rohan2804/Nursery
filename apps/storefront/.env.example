# Copy to .env.local. Without the Supabase values the storefront uses its built-in catalog.
NEXT_PUBLIC_SITE_URL=https://www.vanam.in
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Must match REVALIDATE_SECRET in apps/admin/.env.local
REVALIDATE_SECRET=change-me-to-a-long-random-string
